      "/current/live_shadow/live_shadow_status.json"
    ],
    "put": 405,
    "auth": "EDGE_RESEARCH_DURABLE_URL + EDGE_RESEARCH_DURABLE_TOKEN"
  },
  "ui": {
    "remote_when": "MRBOT_LIVE_PXV_UI_SOURCE=auto and EDGE_RESEARCH_DURABLE_URL set",
