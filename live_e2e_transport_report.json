  "alert_eligible": false,
  "tests": {
    "command": "python3 -m pytest tests/test_live_e2e_transport.py tests/test_live_camera_shadow.py tests/test_live_candidate_pxv_ui.py tests/test_live_shadow_transport_contract.py tests/test_live_candidate_first_seen.py tests/test_edge_research_artifact_server.py tests/test_live_session_01.py",
