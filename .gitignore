# Runtime brain artifacts (local/Streamlit ephemeral — not source)
brain/*.csv
brain/.leader_memory.lock
brain/backups/

# Python / test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Intraday memory Parquet data (local/test — not committed to Git)
/intraday_memory/

# Foreign-flow history: keep canonical + manifests; raw provider JSONL is regenerable
data/foreign_flow_history/raw/*.jsonl
!data/foreign_flow_history/raw/.gitkeep
