# Mr.BOT Edge Research durable artifact service — copy to /etc/mrbot/edge-artifacts.env
# chmod 600 /etc/mrbot/edge-artifacts.env
#
# Replace CHANGE_ME with a long random bearer token (openssl rand -hex 32).

EDGE_RESEARCH_ARTIFACT_TOKEN=CHANGE_ME
EDGE_RESEARCH_ARTIFACT_STORAGE=/var/lib/mrbot/edge_research_durable
EDGE_RESEARCH_ARTIFACT_HOST=127.0.0.1
EDGE_RESEARCH_ARTIFACT_PORT=8765
EDGE_RESEARCH_ARTIFACT_MAX_UPLOAD_BYTES=52428800
