# Copy to /etc/mrbot/daily-research.env (mode 600) on production host.
# Timer/service remain DISABLED until operator explicitly enables after DAY_0_SMOKE.
#
# Sidecar publish does NOT need EDGE_RESEARCH_DURABLE_* on the VPS.
# mrbot-daily-research.service also loads /etc/mrbot/edge-artifacts.env
# (EDGE_RESEARCH_ARTIFACT_STORAGE / TOKEN / HOST / PORT) — the same file used
# by mrbot-edge-artifacts.service.
MRBOT_DAILY_RESEARCH_DATA_DIR=/opt/mrbot-camera/data/edge_research
MRBOT_DAILY_RESEARCH_MODE=LIVE_FORWARD
