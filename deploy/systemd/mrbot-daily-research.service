[Unit]
Description=Mr.BOT Production Daily Research run (NOT enabled by default)
Documentation=file:/opt/mrbot-camera/diagnostics/phase_3k5_live_forward_production_readiness/LIVE_FORWARD_DEPLOYMENT_RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mrbot-camera
EnvironmentFile=-/etc/mrbot/daily-research.env
# Derive VN trading session date; authoritative EOD gate blocks incomplete sessions.
ExecStart=/opt/mrbot-camera-venv/bin/python -m modules.edge_research.opr_bridge.production_daily_run_entrypoint --derive-vn-date --mode LIVE_FORWARD --use-lock
Nice=10
IOSchedulingClass=best-effort
TimeoutStartSec=3600
Restart=no
SuccessExitStatus=2 3 10

[Install]
WantedBy=multi-user.target
