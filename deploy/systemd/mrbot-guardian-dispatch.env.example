# Copy to /etc/mrbot/guardian-dispatch.env and chmod 600, owned by root.
# Do not commit a token. This credential may only start guardian-close.
# It must not have contents write.

GUARDIAN_DISPATCH_TOKEN=
GUARDIAN_DISPATCH_REPO=SONVODAI/scanner-ga-chien-clean
GUARDIAN_DISPATCH_WORKFLOW=guardian-close.yml
GUARDIAN_DISPATCH_REF=main
GUARDIAN_DISPATCH_STATUS=/var/lib/mrbot/guardian_dispatch/last.json
GUARDIAN_DISPATCH_TIMEOUT_SEC=20
