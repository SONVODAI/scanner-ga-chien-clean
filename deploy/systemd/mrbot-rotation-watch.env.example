# Isolated Rotation Watch loop — copy to /etc/mrbot/rotation-watch.env
# chmod 600 /etc/mrbot/rotation-watch.env
#
# Isolated sidecar tree + store. Never Camera parquet / Candidate / Edge paths.

MRBOT_ROTATION_WATCH_STORE=/var/lib/mrbot/rotation_watch
MRBOT_ROTATION_WATCH_DIR=/opt/mrbot-rotation-watch/data/rotation_watch
PYTHONPATH=/opt/mrbot-rotation-watch:/opt/mrbot-camera
