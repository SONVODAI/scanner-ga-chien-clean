[Unit]
Description=Mr.BOT V2 live SHADOW WHEN cycle (candidate KBS read, not the Camera archive)
Documentation=file:/opt/mrbot-live-shadow/scripts/run_live_camera_shadow.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mrbot-live-shadow
Environment=PYTHONPATH=/opt/mrbot-live-shadow
Environment=MRBOT_V2_SIDECAR_SOURCE=github
Environment=MRBOT_LIVE_PXV_SHADOW_STORE=/var/lib/mrbot/live_pxv_shadow
Environment=MRBOT_LIVE_CAMERA_SHADOW_OUT=/var/lib/mrbot/live_pxv_shadow/v2_live_when
EnvironmentFile=-/etc/mrbot/intraday.env
ExecStart=/opt/mrbot-camera-venv/bin/python /opt/mrbot-live-shadow/scripts/run_live_camera_shadow.py --live --v2-when
Nice=10
Restart=no

[Install]
WantedBy=multi-user.target
