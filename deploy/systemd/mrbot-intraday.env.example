# Mr.BOT Intraday Memory collector environment
# Copy to /etc/mrbot/intraday.env and chmod 600
# Do NOT commit secrets to git.

MRBOT_INTRADAY_DATA_ROOT=/var/lib/mrbot/intraday_memory
MRBOT_APP_PY_PATH=/opt/mrbot-camera/app.py

# Optional — Community tier (leave unset for guest tier)
# VNSTOCK_API_KEY=

# Optional — override throttle (guest default 18, community max 55)
# MRBOT_INTRADAY_RPM=18
