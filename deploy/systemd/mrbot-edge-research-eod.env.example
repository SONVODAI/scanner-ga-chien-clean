# Shared by mrbot-edge-research-eod.service
# Copy to /etc/mrbot/edge-research.env and adjust paths.

# Optional override of Edge Research data dir (defaults to repo data/edge_research)
# EDGE_RESEARCH_DATA_DIR=/opt/mrbot-camera/data/edge_research

# Durable bundle backend (same as Streamlit EOD path)
# EDGE_RESEARCH_DURABLE_PATH=/var/lib/mrbot/edge_research_durable
# EDGE_RESEARCH_DURABLE_BACKEND=fs

# Headless EOD is authoritative. Streamlit only fallback-runs if this file
# has no SUCCESS/SKIPPED row for the session.
# TZ is taken from the systemd timer (Asia/Ho_Chi_Minh).

