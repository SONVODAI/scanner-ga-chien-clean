{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForeignFlowConfirmationForwardEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "protocol_id",
    "candidate_id",
    "trade_date",
    "symbol",
    "feature",
    "frozen_feature_value",
    "threshold_state",
    "eligibility_ok",
    "eligibility_reason",
    "baseline_state",
    "source",
    "source_provenance",
    "dataset_hash_or_version",
    "created_at",
    "t0_close",
    "outcome_maturity_trade_date_expected",
    "protocol_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Stable key: {candidate_id}|{trade_date}|{symbol}"
    },
    "protocol_id": { "const": "ff_confirmation_v1" },
    "candidate_id": {
      "type": "string",
      "enum": [
        "FFC1_PRIMARY_ABN_ABS_Z20_T10",
        "FFC1_SECONDARY_NET_HI_PCT90_T10",
        "FFC1_OPTIONAL_STREAK_NEG_LE_M5_T10"
      ]
    },
    "trade_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "symbol": { "type": "string", "minLength": 1 },
    "feature": {
      "type": "string",
      "enum": ["abn_abs_z20", "net_hi_pct90", "streak_neg_le_m5"]
    },
    "frozen_feature_value": {
      "type": ["number", "null"],
      "description": "Raw intermediate (net_z_60 abs, net_pct_252, or net_streak). NULL allowed; never coerce NULL→0."
    },
    "threshold_state": {
      "type": "boolean",
      "description": "True iff trigger condition met under frozen definition with finite inputs."
    },
    "eligibility_ok": { "type": "boolean" },
    "eligibility_reason": { "type": "string" },
    "baseline_state": {
      "type": "object",
      "required": ["era", "unconditional_eligible_flag"],
      "properties": {
        "era": { "const": "confirmation_post_2026-08-24" },
        "unconditional_eligible_flag": { "type": "boolean" },
        "px_ret_1": { "type": ["number", "null"] },
        "px_ret_20": { "type": ["number", "null"] }
      }
    },
    "source": { "type": "string", "examples": ["HSX_FOREIGN_API"] },
    "source_provenance": { "type": "string" },
    "dataset_hash_or_version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "t0_close": { "type": ["number", "null"] },
    "lookback_complete": { "type": "boolean" },
    "dq_gate_pass": { "type": "boolean" },
    "dq_failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outcome_maturity_trade_date_expected": {
      "type": ["string", "null"],
      "description": "Filled when session calendar known; else null until resolvable. Never invent."
    },
    "protocol_hash": { "type": "string" },
    "code_commit": { "type": "string" },
    "append_only_note": {
      "type": "string",
      "description": "Original T0 event must never be rewritten after append."
    }
  }
}
